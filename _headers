# Cloudflare Pages response headers (docs/plans/2026-10-28-signup-dashboard.md).
# The Sign-up dashboard and the Crash course pages get these. The landing page gets no new headers.
# Each header must stay on one line.

/dashboard
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3/dist/umd/supabase.js; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src https://ijpvbxglhxktnkabjdif.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

/dashboard.html
  Content-Security-Policy: default-src 'none'; script-src 'self' https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.117.3/dist/umd/supabase.js; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src https://ijpvbxglhxktnkabjdif.supabase.co; frame-ancestors 'none'; base-uri 'none'; form-action 'none'
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff

